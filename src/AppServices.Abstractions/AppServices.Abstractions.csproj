<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>Bennewitz.Ninja.AppServices.Abstractions</PackageId>
    <AssemblyName>AppServices.Abstractions</AssemblyName>
    <Description>Application service contracts and the dialog vocabulary: shell launching, environment, sharing, dialogs and pickers. Framework-free, so a test can fake them without referencing a UI toolkit.</Description>
    <PackageTags>abstractions;contracts;app-services;dialogs</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- ⛔ THIS PROJECT HAS NO REFERENCES, AND THAT IS THE POINT. It is the package a test or a
       non-UI host consumes, so it must reach nothing. Adding any reference here is the change
       that quietly undoes the split; AppServicesLayeringTests fails the build if one appears. -->
</Project>
