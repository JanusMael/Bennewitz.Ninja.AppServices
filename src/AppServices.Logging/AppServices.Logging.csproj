<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>Bennewitz.Ninja.AppServices.Logging</PackageId>
    <AssemblyName>AppServices.Logging</AssemblyName>
    <Description>Serilog sinks for desktop applications, starting with a bucketed rolling file sink that keeps a bounded number of files per bucket.</Description>
    <PackageTags>serilog;sink;logging;rolling-file</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- ⛔ SERILOG AND NOTHING ELSE. No Avalonia, no window, no reference to the sibling packages.
       A sink is inherently a Serilog thing and inherently not a UI thing, which is what makes
       this the one place Serilog is legitimate in this lane.
       ⚠ LiveLogWindowSink did NOT come here, though the split document placed it here: it calls
       LiveLogWindow.EnqueueLog directly, so it is a UI type wearing a sink's name. It stays with
       the window in OpenForge2k until both ship together. -->
  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
</Project>
